    <answerpreload><![CDATA[def eval_script(tokens):
    stack = []
    for t in tokens:
        # Complete: handle OP_ADD, OP_SUB, OP_DUP, OP_EQUAL, else push int(t)
        pass
    return stack[-1]
]]></answerpreload>
    <globalextra></globalextra>
    <useace></useace>
    <resultcolumns></resultcolumns>
    <template></template>
    <iscombinatortemplate></iscombinatortemplate>
    <allowmultiplestdins></allowmultiplestdins>
    <answer><![CDATA[def eval_script(tokens):
    stack = []
    for t in tokens:
        if t == "OP_ADD":
            b = stack.pop(); a = stack.pop(); stack.append(a + b)
        elif t == "OP_SUB":
            b = stack.pop(); a = stack.pop(); stack.append(a - b)
        elif t == "OP_DUP":
            stack.append(stack[-1])
        elif t == "OP_EQUAL":
            b = stack.pop(); a = stack.pop(); stack.append(1 if a == b else 0)
        else:
            stack.append(int(t))
    return stack[-1]
]]></answer>

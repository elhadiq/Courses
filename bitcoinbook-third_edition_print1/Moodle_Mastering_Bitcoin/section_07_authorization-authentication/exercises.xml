    <answerpreload><![CDATA[def check_multisig(pubkeys, sigs, m):
    valid = set()
    # Complete: collect distinct signing keys that are in pubkeys
    return len(valid) >= m
]]></answerpreload>
    <globalextra></globalextra>
    <useace></useace>
    <resultcolumns></resultcolumns>
    <template></template>
    <iscombinatortemplate></iscombinatortemplate>
    <allowmultiplestdins></allowmultiplestdins>
    <answer><![CDATA[def check_multisig(pubkeys, sigs, m):
    valid = set()
    for s in sigs:
        if s in pubkeys:
            valid.add(s)
    return len(valid) >= m
]]></answer>

    <answer><![CDATA[def write_varint(n):
    if n < 0xfd:
        return bytes([n])
    elif n <= 0xffff:
        return bytes([0xfd]) + n.to_bytes(2, "little")
    elif n <= 0xffffffff:
        return bytes([0xfe]) + n.to_bytes(4, "little")
    else:
        return bytes([0xff]) + n.to_bytes(8, "little")
]]></answer>

    <answer><![CDATA[def read_varint(data):
    n = data[0]
    if n < 0xfd:
        return n
    elif n == 0xfd:
        return int.from_bytes(data[1:3], "little")
    elif n == 0xfe:
        return int.from_bytes(data[1:5], "little")
    else:
        return int.from_bytes(data[1:9], "little")
]]></answer>

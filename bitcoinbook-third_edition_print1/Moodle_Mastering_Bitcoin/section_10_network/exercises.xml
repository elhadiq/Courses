  <question type="coderunner">
    <name><text>S10 Q3 — New inventory only</text></name>
    <questiontext format="html">
      <text><![CDATA[<div style="background:#f8fafc;border:1px solid #e2e8f0;border-left:5px solid #f7931a;border-radius:8px;padding:18px 22px;margin-bottom:16px;">
<p style="color:#9a3412;font-family:Georgia,serif;font-size:13px;font-weight:bold;letter-spacing:2px;text-transform:uppercase;margin:0 0 8px;">S10 Q3 — New inventory</p>
<p style="color:#1e293b;font-family:Georgia,serif;font-size:15px;line-height:1.8;margin:0;">A node fetches only inventory items it does not already have, and never twice.</p>
</div>
<p style="font-family:Georgia,serif;font-size:15px;line-height:1.8;">Write <strong><code>new_inventory(known, inv)</code></strong> returning the items of <code>inv</code> that are not in <code>known</code>, in order, with duplicates removed.</p>
<div style="background:#fdf4ff;border-left:5px solid #9333ea;border-radius:8px;padding:12px 18px;margin:12px 0;">
<pre style="color:#3b0764;font-family:'Courier New',monospace;font-size:13px;margin:0;background:none;border:none;">new_inventory(["a","b"], ["b","c","c","d"]) &rarr; ['c', 'd']</pre>
</div>]]></text>
    </questiontext>

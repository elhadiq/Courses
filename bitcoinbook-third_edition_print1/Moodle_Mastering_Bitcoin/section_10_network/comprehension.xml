    <questiontext format="html"><text><![CDATA[<p>A bloom-filter test finds a 0 at one of an item's positions. What does that mean?</p>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>Any 0 bit is a definite negative.</p>]]></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <correctfeedback format="html"><text>Correct.</text></correctfeedback>
    <partiallycorrectfeedback format="html"><text>Partially correct.</text></partiallycorrectfeedback>
    <incorrectfeedback format="html"><text>Not quite — review the lesson.</text></incorrectfeedback>
    <answer fraction="100" format="html"><text><![CDATA[The item is definitely not in the set]]></text><feedback format="html"><text>Correct.</text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[The item is definitely in the set]]></text><feedback format="html"><text>A 0 rules it out.</text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[The item is probably in the set]]></text><feedback format="html"><text>That is when all bits are 1.</text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[The filter is broken]]></text><feedback format="html"><text>No.</text></feedback></answer>

]]></answerpreload>
    <globalextra></globalextra>
    <useace></useace>
    <resultcolumns></resultcolumns>
    <template></template>
    <iscombinatortemplate></iscombinatortemplate>
    <allowmultiplestdins></allowmultiplestdins>
    <answer><![CDATA[def parse_path(path):
    parts = path.split("/")[1:]
    result = []
    for p in parts:
        if p.endswith("'") or p.endswith("h"):
            result.append(int(p[:-1]) + 2**31)
        else:
            result.append(int(p))
    return result
]]></answer>

  <question type="numerical">
    <name><text>S9 C1 — Fee rate</text></name>
    <questiontext format="html"><text><![CDATA[<p>A 200 vB transaction pays 3,000 sat. What is its fee rate in sat/vB?</p>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>3000 / 200 = 15 sat/vB.</p>]]></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <answer fraction="100" format="moodle_auto_format"><text>15</text><feedback format="html"><text>Correct.</text></feedback><tolerance>0</tolerance></answer>
  </question>

  <question type="numerical">
    <name><text>S9 C2 — Fee for a rate</text></name>
    <questiontext format="html"><text><![CDATA[<p>You want 8 sat/vB on a 150 vB transaction. What fee (in satoshis) must you pay?</p>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>8 * 150 = 1200 sat.</p>]]></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <answer fraction="100" format="moodle_auto_format"><text>1200</text><feedback format="html"><text>Correct.</text></feedback><tolerance>0</tolerance></answer>
  </question>


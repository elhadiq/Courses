    <answerboxlines>18</answerboxlines>
    <answerboxcolumns>100</answerboxcolumns>
    <answerpreload><![CDATA[def confirmed_balance(utxos, min_conf=6):
    total = 0
    # Complete: add amount_sat for UTXOs with enough confirmations
    return total
]]></answerpreload>
    <globalextra></globalextra>
    <useace></useace>
    <resultcolumns></resultcolumns>
    <template></template>
    <iscombinatortemplate></iscombinatortemplate>
    <allowmultiplestdins></allowmultiplestdins>
    <answer><![CDATA[def confirmed_balance(utxos, min_conf=6):
    total = 0
    for u in utxos:
        if u["confirmations"] >= min_conf:
            total += u["amount_sat"]
    return total
]]></answer>

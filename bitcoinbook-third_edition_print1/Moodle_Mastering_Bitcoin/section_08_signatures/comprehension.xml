    <answer fraction="0" format="html"><text><![CDATA[SIGHASH_NONE]]></text><feedback format="html"><text>That is 0x02.</text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[ALL + ANYONECANPAY]]></text><feedback format="html"><text>That would be 0x81.</text></feedback></answer>
  </question>


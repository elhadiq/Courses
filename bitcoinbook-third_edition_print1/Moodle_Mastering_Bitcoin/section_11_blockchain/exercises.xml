    <answer><![CDATA[import hashlib

def d(x):
    return hashlib.sha256(hashlib.sha256(x).digest()).digest()

def merkle_root(leaves):
    layer = list(leaves)
    if len(layer) == 1:
        return layer[0]
    while len(layer) > 1:
        if len(layer) % 2 == 1:
            layer.append(layer[-1])
        layer = [d(layer[i] + layer[i + 1]) for i in range(0, len(layer), 2)]
    return layer[0]
]]></answer>

    <answer><![CDATA[import hashlib

def d(x):
    return hashlib.sha256(hashlib.sha256(x).digest()).digest()

def verify_merkle(leaf, proof, root):
    h = leaf
    for sibling, is_left in proof:
        if is_left:
            h = d(sibling + h)
        else:
            h = d(h + sibling)
    return h == root
]]></answer>

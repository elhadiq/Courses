      <text>n : rand_with_step(8,16,2);
M : rand_with_step(1,4,1);
ta1 : sin((2*k+1)*theta)^2;
ta2 : %pi/4*sqrt(N/M);
ta3 : %pi/4*sqrt(2^n/M);</text>

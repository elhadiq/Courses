</answerpreload><globalextra /><useace /><resultcolumns /><template /><iscombinatortemplate /><allowmultiplestdins /><answer>def utilite_esperee(action):
    return round(sum(p * u for p, u in action), 4)

def meilleure_action(actions):
    meilleur, valeur = None, None
    for nom in sorted(actions):
        e = utilite_esperee(actions[nom])
        if valeur is None or e &gt; valeur:
            meilleur, valeur = nom, e
    return (meilleur, valeur)

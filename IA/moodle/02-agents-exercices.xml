"><text /></generalfeedback><defaultgrade>2.0000000</defaultgrade><penalty>0.0000000</penalty><hidden>0</hidden><idnumber /><coderunnertype>python3</coderunnertype><prototypetype>0</prototypetype><allornothing>0</allornothing><penaltyregime>0</penaltyregime><precheck>0</precheck><hidecheck>0</hidecheck><showsource>0</showsource><answerboxlines>18</answerboxlines><answerboxcolumns>100</answerboxcolumns><answerpreload>def maj_etat(etat, action, percept, n):
    # 1. predire par l effet de l action, en restant dans le couloir
    # 2. si le percept est absent ou incoherent, garder la prediction
    # 3. sinon faire confiance au percept
    ...
</answerpreload><globalextra /><useace /><resultcolumns /><template /><iscombinatortemplate /><allowmultiplestdins /><answer>def maj_etat(etat, action, percept, n):
    prediction = etat + action
    if prediction &lt; 0:
        prediction = 0
    if prediction &gt; n - 1:
        prediction = n - 1
    if percept is None:
        return prediction
    if abs(percept - prediction) &gt; 1:
        return prediction
    return percept

</answerpreload><globalextra /><useace /><resultcolumns /><template /><iscombinatortemplate /><allowmultiplestdins /><answer>def reflexe(percept):
    position, sale = percept
    if sale:
        return 'aspirer'
    return 'droite' if position == 'G' else 'gauche'

def simuler(agent, etat0, n):
    position, sg, sd = etat0
    score = 0
    for _ in range(n):
        sale = sg if position == 'G' else sd
        action = agent((position, sale))
        if action == 'aspirer':
            if position == 'G':
                sg = False
            else:
                sd = False
        elif action == 'droite':
            position = 'D'
        elif action == 'gauche':
            position = 'G'
        score += (0 if sg else 1) + (0 if sd else 1)
    return ((position, sg, sd), score)

</answerpreload><globalextra /><useace /><resultcolumns /><template /><iscombinatortemplate /><allowmultiplestdins /><answer>from collections import deque

def ac3(domaines, arcs, contrainte):
    file = deque(arcs)
    while file:
        x, y = file.popleft()
        garde = [a for a in domaines[x]
                 if any(contrainte(x, a, y, b) for b in domaines[y])]
        if len(garde) != len(domaines[x]):
            domaines[x][:] = garde
            if not domaines[x]:
                return False
            for u, v in arcs:
                if v == x and u != y:
                    file.append((u, x))
    return True

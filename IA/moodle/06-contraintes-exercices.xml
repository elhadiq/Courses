</answerpreload><globalextra /><useace /><resultcolumns /><template /><iscombinatortemplate /><allowmultiplestdins /><answer>def choisir_variable(domaines, voisins, affectation):
    libres = [v for v in sorted(domaines) if v not in affectation]
    if not libres:
        return None
    def cle(v):
        degre = sum(1 for u in voisins.get(v, []) if u not in affectation)
        return (len(domaines[v]), -degre, v)
    return min(libres, key=cle)

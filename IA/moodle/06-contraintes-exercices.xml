</answerpreload><globalextra /><useace /><resultcolumns /><template /><iscombinatortemplate /><allowmultiplestdins /><answer>def conflits(pos, col):
    n = len(pos)
    return sum(1 for j in range(n) if j != col and
               (pos[j] == pos[col] or abs(pos[j] - pos[col]) == abs(j - col)))

def meilleure_ligne(pos, col):
    n = len(pos)
    ancien = pos[col]
    meilleur, ligne = None, ancien
    for l in range(n):
        pos[col] = l
        c = conflits(pos, col)
        if meilleur is None or c &lt; meilleur:
            meilleur, ligne = c, l
    pos[col] = ancien
    return ligne

def total(pos):
    return sum(conflits(pos, j) for j in range(len(pos))) // 2

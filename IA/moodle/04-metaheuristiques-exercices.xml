</answerpreload><globalextra /><useace /><resultcolumns /><template /><iscombinatortemplate /><allowmultiplestdins /><answer>from math import exp

def probabilite_acceptation(delta, T):
    if delta &gt; 0:
        return 1.0
    if T &lt;= 0:
        return 0.0
    return round(exp(delta / T), 6)

def recuit(depart, voisin, valeur, T0, refroid, n_pas, tirages):
    x = depart
    meilleur = x
    for k in range(n_pas):
        T = T0 * refroid ** k
        y = voisin(x, k)
        delta = valeur(y) - valeur(x)
        if delta &gt; 0:
            x = y
        elif probabilite_acceptation(delta, T) &gt; tirages[k]:
            x = y
        if valeur(x) &gt; valeur(meilleur):
            meilleur = x
    return (meilleur, valeur(meilleur))

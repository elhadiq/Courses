</answerpreload><globalextra /><useace /><resultcolumns /><template /><iscombinatortemplate /><allowmultiplestdins /><answer>def montee(depart, voisins, valeur):
    x = depart
    while True:
        candidats = voisins(x)
        if not candidats:
            return x
        meilleur = candidats[0]
        for v in candidats[1:]:
            if valeur(v) &gt; valeur(meilleur):
                meilleur = v
        if valeur(meilleur) &lt;= valeur(x):
            return x
        x = meilleur

def redemarrages(departs, voisins, valeur):
    meilleur, meilleure = None, None
    for d in departs:
        x = montee(d, voisins, valeur)
        if meilleure is None or valeur(x) &gt; meilleure:
            meilleur, meilleure = x, valeur(x)
    return (meilleur, meilleure)

def proba_succes(p, n):
    return round(1 - (1 - p) ** n, 4)

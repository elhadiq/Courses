</answerpreload><globalextra /><useace /><resultcolumns /><template /><iscombinatortemplate /><allowmultiplestdins /><answer>def croiser(p1, p2, coupe):
    return list(p1[:coupe]) + list(p2[coupe:])

def muter(individu, positions):
    resultat = list(individu)
    for k in positions:
        resultat[k] = 1 - resultat[k]
    return resultat

def tournoi(population, adaptation, i, j):
    return population[i] if adaptation(population[i]) &gt;= adaptation(population[j]) else population[j]

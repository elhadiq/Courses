</answerpreload><globalextra /><useace /><resultcolumns /><template /><iscombinatortemplate /><allowmultiplestdins /><answer>def filtrer(croyance, observations, p_reste, p_capteur):
    pvv, pfv = p_reste
    pov, pof = p_capteur
    b = croyance
    resultat = []
    for obs in observations:
        prediction = b * pvv + (1 - b) * pfv
        if obs:
            e1 = prediction * pov
            e0 = (1 - prediction) * pof
        else:
            e1 = prediction * (1 - pov)
            e0 = (1 - prediction) * (1 - pof)
        b = e1 / (e1 + e0)
        resultat.append(round(b, 4))
    return resultat

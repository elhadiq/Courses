</answerpreload><globalextra /><useace /><resultcolumns /><template /><iscombinatortemplate /><allowmultiplestdins /><answer>def depistage(prevalence, sensibilite, specificite, population):
    malades = prevalence * population
    sains = population - malades
    vp = malades * sensibilite
    fn = malades - vp
    vn = sains * specificite
    fp = sains - vn
    total_positifs = vp + fp
    post = round(vp / total_positifs, 4) if total_positifs &gt; 0 else 0.0
    return {'malades': round(malades), 'vp': round(vp), 'fp': round(fp),
            'fn': round(fn), 'vn': round(vn), 'posterieur': post}

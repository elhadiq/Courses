</answerpreload><globalextra /><useace /><resultcolumns /><template /><iscombinatortemplate /><allowmultiplestdins /><answer>from itertools import product

def jointe(reseau, monde):
    p = 1.0
    for var, (parents, table) in reseau.items():
        cle = tuple(monde[q] for q in parents)
        pv = table[cle]
        p *= pv if monde[var] else 1 - pv
    return round(p, 8)

def inferer(reseau, cible, observations):
    variables = list(reseau)
    num, den = 0.0, 0.0
    for valeurs in product([False, True], repeat=len(variables)):
        monde = dict(zip(variables, valeurs))
        if any(monde[k] != v for k, v in observations.items()):
            continue
        p = 1.0
        for var, (parents, table) in reseau.items():
            cle = tuple(monde[q] for q in parents)
            pv = table[cle]
            p *= pv if monde[var] else 1 - pv
        den += p
        if monde[cible]:
            num += p
    return round(num / den, 4) if den &gt; 0 else 0.0

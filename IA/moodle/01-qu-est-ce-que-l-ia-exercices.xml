</answerpreload><globalextra /><useace /><resultcolumns /><template /><iscombinatortemplate /><allowmultiplestdins /><answer>from math import sqrt

def depouiller(designations):
    n = len(designations)
    c = sum(1 for d in designations if d)
    taux = round(c / n, 4) if n else 0.0
    return {'parties': n, 'correctes': c, 'taux': taux, 'reussit': taux &lt;= 0.5}

def marge(n):
    if n == 0:
        return 0.0
    return round(sqrt(0.25 / n), 4)

</answerpreload><globalextra /><useace /><resultcolumns /><template /><iscombinatortemplate /><allowmultiplestdins /><answer>def periode(annee, periodes):
    for debut, fin, nom in periodes:
        if debut &lt;= annee &lt; fin:
            return nom
    return None

def jalon_proche(annee, jalons):
    meilleur = None
    for a, nom in sorted(jalons):
        if meilleur is None or abs(a - annee) &lt; abs(meilleur[0] - annee):
            meilleur = (a, nom)
    return meilleur[1] if meilleur else None

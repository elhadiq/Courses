</answerpreload><globalextra /><useace /><resultcolumns /><template /><iscombinatortemplate /><allowmultiplestdins /><answer>def chainage_avant(faits, regles):
    connus = set(faits)
    trace = []
    while True:
        declenchee = None
        for conditions, conclusion in regles:
            if conclusion in connus:
                continue
            if set(conditions) &lt;= connus:
                declenchee = conclusion
                break
        if declenchee is None:
            return (sorted(connus), trace)
        connus.add(declenchee)
        trace.append(declenchee)

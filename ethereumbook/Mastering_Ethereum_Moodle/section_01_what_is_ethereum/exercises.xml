    <answerpreload><![CDATA[def gas_remaining(gas_limit, costs):
    # Subtract each cost in order; halt with "out of gas" if you can't afford the next one.
    return ...
]]></answerpreload>
    <globalextra></globalextra>
    <useace></useace>
    <resultcolumns></resultcolumns>
    <template></template>

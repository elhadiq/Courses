    <showsource>0</showsource>
    <answerboxlines>20</answerboxlines>
    <answerboxcolumns>100</answerboxcolumns>
    <answerpreload><![CDATA[def evm_stack(ops):
    stack = []
    for op in ops:
        # push an int; "ADD"/"MUL" pop two and push the result.
        pass
    return stack[-1]
]]></answerpreload>
    <globalextra></globalextra>
    <useace></useace>
    <resultcolumns></resultcolumns>
    <template></template>
    <iscombinatortemplate></iscombinatortemplate>
    <allowmultiplestdins></allowmultiplestdins>
    <answer><![CDATA[def evm_stack(ops):
    stack = []
    for op in ops:
        if op == "ADD":
            b = stack.pop()
            a = stack.pop()
            stack.append(a + b)
        elif op == "MUL":
            b = stack.pop()
            a = stack.pop()
            stack.append(a * b)
        else:
            stack.append(op)
    return stack[-1]
]]></answer>

  <question type="coderunner">
    <name><text>S14 Q1 — Tiny stack machine</text></name>
    <questiontext format="html">
      <text><![CDATA[<div style="background:#f8fafc;border:1px solid #e2e8f0;border-left:5px solid #f7931a;border-radius:8px;padding:18px 22px;margin-bottom:16px;">
<p style="color:#9a3412;font-family:Georgia,serif;font-size:13px;font-weight:bold;letter-spacing:2px;text-transform:uppercase;margin:0 0 8px;">S14 Q1 — Stack execution</p>
<p style="color:#1e293b;font-family:Georgia,serif;font-size:15px;line-height:1.8;margin:0;">The EVM works on a last-in, first-out stack.</p>
</div>
<p style="font-family:Georgia,serif;font-size:15px;line-height:1.8;">Write <strong><code>evm_stack(ops)</code></strong> that runs a list of operations on a stack. An integer means &ldquo;push this value.&rdquo; The string <code>"ADD"</code> pops the top two values and pushes their sum; <code>"MUL"</code> pops two and pushes their product. Return the value left on top of the stack. For example <code>evm_stack([2, 3, "ADD"])</code> returns <code>5</code>.</p>]]></text>
    </questiontext>
    <generalfeedback format="html"><text></text></generalfeedback>
    <defaultgrade>2.0000000</defaultgrade>
    <penalty>0.0000000</penalty>

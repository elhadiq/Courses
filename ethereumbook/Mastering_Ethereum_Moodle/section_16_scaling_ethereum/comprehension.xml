    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <correctfeedback format="html"><text>Correct.</text></correctfeedback>
    <partiallycorrectfeedback format="html"><text>Partially correct.</text></partiallycorrectfeedback>
    <incorrectfeedback format="html"><text>Review section 1 of the lesson.</text></incorrectfeedback>
    <answer fraction="100" format="html"><text><![CDATA[Decentralization, security, and scalability]]></text><feedback format="html"><text>Correct.</text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[Speed, cost, and privacy]]></text><feedback format="html"><text>No.</text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[Safety, liveness, and finality]]></text><feedback format="html"><text>Those are consensus properties.</text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[Storage, memory, and calldata]]></text><feedback format="html"><text>Those are EVM data areas.</text></feedback></answer>
  </question>


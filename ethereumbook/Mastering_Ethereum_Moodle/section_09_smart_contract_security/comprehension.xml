  <question type="truefalse">
    <name><text>S9 C4 — View functions</text></name>
    <questiontext format="html"><text><![CDATA[<p>Because view functions do not modify state, they can never be involved in a reentrancy attack.</p>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>False. Read-only reentrancy exploits view functions that other contracts trust while state is stale.</p>]]></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>1.0000000</penalty>
    <hidden>0</hidden>
    <answer fraction="0" format="moodle_auto_format"><text>true</text><feedback format="html"><text>Incorrect.</text></feedback></answer>
    <answer fraction="100" format="moodle_auto_format"><text>false</text><feedback format="html"><text>Correct.</text></feedback></answer>
  </question>

  <question type="multichoice">
    <name><text>S9 C5 — Reentrancy lock</text></name>
    <questiontext format="html"><text><![CDATA[<p>What does a reentrancy lock (such as OpenZeppelin's ReentrancyGuard) do?</p>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>It sets a flag on entry and clears it on exit, so a function cannot be re-entered while it is still running.</p>]]></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <correctfeedback format="html"><text>Correct.</text></correctfeedback>
    <partiallycorrectfeedback format="html"><text>Partially correct.</text></partiallycorrectfeedback>
    <incorrectfeedback format="html"><text>Review section 4 of the lesson.</text></incorrectfeedback>
    <answer fraction="100" format="html"><text><![CDATA[Blocks a function from being re-entered while it is still executing]]></text><feedback format="html"><text>Correct.</text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[Encrypts the contract's storage]]></text><feedback format="html"><text>No.</text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[Reduces the gas cost of a call]]></text><feedback format="html"><text>No.</text></feedback></answer>

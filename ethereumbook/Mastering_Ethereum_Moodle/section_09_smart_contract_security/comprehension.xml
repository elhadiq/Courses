  <question type="multichoice">
    <name><text>S9 C1 — How reentrancy works</text></name>
    <questiontext format="html"><text><![CDATA[<p>What makes a contract vulnerable to a reentrancy attack?</p>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>It makes an external call before updating its own state, so an attacker can re-enter while the state is still inconsistent.</p>]]></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <correctfeedback format="html"><text>Correct.</text></correctfeedback>
    <partiallycorrectfeedback format="html"><text>Partially correct.</text></partiallycorrectfeedback>
    <incorrectfeedback format="html"><text>Review section 2 of the lesson.</text></incorrectfeedback>
    <answer fraction="100" format="html"><text><![CDATA[It sends ether (an external call) before updating its internal state]]></text><feedback format="html"><text>Correct.</text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[It uses too much gas]]></text><feedback format="html"><text>No.</text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[It stores data in a mapping]]></text><feedback format="html"><text>No.</text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[It is written in Vyper]]></text><feedback format="html"><text>No.</text></feedback></answer>
  </question>

  <question type="multichoice">
    <name><text>S9 C2 — CEI order</text></name>
    <questiontext format="html"><text><![CDATA[<p>What is the correct order of the checks-effects-interactions pattern?</p>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>Checks first, then effects (state updates), then interactions (external calls) last.</p>]]></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <correctfeedback format="html"><text>Correct.</text></correctfeedback>
    <partiallycorrectfeedback format="html"><text>Partially correct.</text></partiallycorrectfeedback>
    <incorrectfeedback format="html"><text>Review section 3 of the lesson.</text></incorrectfeedback>
    <answer fraction="100" format="html"><text><![CDATA[Checks, then effects, then interactions]]></text><feedback format="html"><text>Correct.</text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[Interactions, then checks, then effects]]></text><feedback format="html"><text>No — external calls must be last.</text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[Effects, then interactions, then checks]]></text><feedback format="html"><text>No.</text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[Interactions, then effects, then checks]]></text><feedback format="html"><text>No.</text></feedback></answer>
  </question>


</answerpreload><globalextra /><useace /><resultcolumns /><template /><iscombinatortemplate /><allowmultiplestdins /><answer>import math


def _props(labels):
    counts = {}
    for lab in labels:
        counts[lab] = counts.get(lab, 0) + 1
    n = len(labels)
    return [c / n for c in counts.values()]


def gini(labels):
    if not labels:
        return 0.0
    return 1.0 - sum(p * p for p in _props(labels))


def entropy(labels):
    if not labels:
        return 0.0
    return -sum(p * math.log(p, 2) for p in _props(labels) if p &gt; 0)

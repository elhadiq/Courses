</answerpreload><globalextra /><useace /><resultcolumns /><template /><iscombinatortemplate /><allowmultiplestdins /><answer>def oob_indices(n, bootstrap):
    seen = set(bootstrap)
    return [i for i in range(n) if i not in seen]


def oob_fraction(n, bootstrap):
    return len(oob_indices(n, bootstrap)) / n

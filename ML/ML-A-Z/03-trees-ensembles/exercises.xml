</answerpreload><globalextra /><useace /><resultcolumns /><template /><iscombinatortemplate /><allowmultiplestdins /><answer>def ensemble_variance(sigma2, rho, B):
    return rho * sigma2 + (1.0 - rho) * sigma2 / B


def trees_needed(sigma2, rho, target):
    if rho * sigma2 &gt; target:
        return None
    B = 1
    while ensemble_variance(sigma2, rho, B) &gt; target:
        B += 1
        if B &gt; 10 ** 7:
            return None
    return B

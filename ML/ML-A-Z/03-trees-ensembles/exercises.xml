</answerpreload><globalextra /><useace /><resultcolumns /><template /><iscombinatortemplate /><allowmultiplestdins /><answer>def gini(labels):
    if not labels:
        return 0.0
    counts = {}
    for lab in labels:
        counts[lab] = counts.get(lab, 0) + 1
    n = len(labels)
    return 1.0 - sum((c / n) ** 2 for c in counts.values())


def best_split(xs, labels):
    n = len(xs)
    parent = gini(labels)
    values = sorted(set(xs))
    if len(values) &lt; 2:
        return (None, 0.0)
    best_thr, best_gain = None, 0.0
    for a, b in zip(values, values[1:]):
        thr = (a + b) / 2.0
        left = [labels[i] for i in range(n) if xs[i] &lt;= thr]
        right = [labels[i] for i in range(n) if xs[i] &gt; thr]
        if not left or not right:
            continue
        gain = parent - (len(left) / n) * gini(left) - (len(right) / n) * gini(right)
        if gain &gt; best_gain + 1e-12:
            best_thr, best_gain = thr, gain
    return (best_thr, best_gain)

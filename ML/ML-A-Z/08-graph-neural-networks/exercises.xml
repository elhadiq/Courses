</answerpreload><globalextra /><useace /><resultcolumns /><template /><iscombinatortemplate /><allowmultiplestdins /><answer>def propagate(n, edges, h):
    adj = [[] for _ in range(n)]
    for u, v in edges:
        adj[u].append(v)
        adj[v].append(u)
    out = []
    for u in range(n):
        group = adj[u] + [u]
        out.append(sum(h[w] for w in group) / len(group))
    return out


def propagate_k(n, edges, h, k):
    cur = list(h)
    for _ in range(k):
        cur = propagate(n, edges, cur)
    return cur

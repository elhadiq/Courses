</answerpreload><globalextra /><useace /><resultcolumns /><template /><iscombinatortemplate /><allowmultiplestdins /><answer>import math


def gcn_norm(n, edges):
    A = [[0.0] * n for _ in range(n)]
    for u, v in edges:
        A[u][v] = 1.0
        A[v][u] = 1.0
    for i in range(n):
        A[i][i] = 1.0
    d = [sum(row) for row in A]
    out = [[0.0] * n for _ in range(n)]
    for i in range(n):
        for j in range(n):
            if A[i][j] != 0.0:
                out[i][j] = A[i][j] / math.sqrt(d[i] * d[j])
    return out

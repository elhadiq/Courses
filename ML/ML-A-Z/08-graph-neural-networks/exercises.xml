</answerpreload><globalextra /><useace /><resultcolumns /><template /><iscombinatortemplate /><allowmultiplestdins /><answer>def receptive_field(n, edges, source, L):
    adj = [[] for _ in range(n)]
    for u, v in edges:
        adj[u].append(v)
        adj[v].append(u)
    dist = {source: 0}
    queue = [source]
    while queue:
        u = queue.pop(0)
        if dist[u] &gt;= L:
            continue
        for w in adj[u]:
            if w not in dist:
                dist[w] = dist[u] + 1
                queue.append(w)
    return sorted(dist)


def saturation_depth(n, edges, source):
    L = 0
    prev = len(receptive_field(n, edges, source, 0))
    while True:
        L += 1
        cur = len(receptive_field(n, edges, source, L))
        if cur == prev:
            return L - 1
        prev = cur

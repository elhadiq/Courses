</answerpreload><globalextra /><useace /><resultcolumns /><template /><iscombinatortemplate /><allowmultiplestdins /><answer>def wl_colours(n, edges, rounds):
    adj = [[] for _ in range(n)]
    for u, v in edges:
        adj[u].append(v)
        adj[v].append(u)
    col = [0] * n
    for _ in range(rounds):
        sig = [(col[u], tuple(sorted(col[w] for w in adj[u]))) for u in range(n)]
        order = sorted(set(sig))
        col = [order.index(s) for s in sig]
    return col


def wl_distinguishes(n1, e1, n2, e2, rounds):
    a = sorted(wl_colours(n1, e1, rounds))
    b = sorted(wl_colours(n2, e2, rounds))
    return a != b

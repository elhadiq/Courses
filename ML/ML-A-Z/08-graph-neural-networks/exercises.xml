</answerpreload><globalextra /><useace /><resultcolumns /><template /><iscombinatortemplate /><allowmultiplestdins /><answer>def agg(multiset, kind):
    if not multiset:
        return 0.0
    if kind == 'sum':
        return float(sum(multiset))
    if kind == 'mean':
        return sum(multiset) / len(multiset)
    if kind == 'max':
        return float(max(multiset))
    raise ValueError(kind)


def separates(ms1, ms2, kind):
    return abs(agg(ms1, kind) - agg(ms2, kind)) &gt; 1e-12

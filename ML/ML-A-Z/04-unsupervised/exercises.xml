    return sum((x - y) ** 2 for x, y in zip(a, b))


def assign(points, centroids):
    labels = []
    for p in points:
        best, bd = 0, None
        for j, c in enumerate(centroids):
            d = _d2(p, c)
            if bd is None or d &lt; bd:
                bd, best = d, j
        labels.append(best)
    return labels


def inertia(points, centroids, labels):
    return sum(_d2(p, centroids[l]) for p, l in zip(points, labels))

</answerpreload><globalextra /><useace /><resultcolumns /><template /><iscombinatortemplate /><allowmultiplestdins /><answer>def _d2(a, b):
    return sum((x - y) ** 2 for x, y in zip(a, b))


def farthest_seed(points, k):
    chosen = [list(points[0])]
    while len(chosen) &lt; k:
        best_i, best_d = 0, -1.0
        for i, p in enumerate(points):
            d = min(_d2(p, c) for c in chosen)
            if d &gt; best_d:
                best_d, best_i = d, i
        chosen.append(list(points[best_i]))
    return chosen

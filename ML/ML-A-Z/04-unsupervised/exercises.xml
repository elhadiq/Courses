</answerpreload><globalextra /><useace /><resultcolumns /><template /><iscombinatortemplate /><allowmultiplestdins /><answer>import math


def center(points):
    n = len(points)
    dim = len(points[0])
    means = [sum(p[j] for p in points) / n for j in range(dim)]
    return [[p[j] - means[j] for j in range(dim)] for p in points]


def projected_variance(points, direction):
    c = center(points)
    norm = math.sqrt(sum(v * v for v in direction))
    if norm == 0:
        return 0.0
    u = [v / norm for v in direction]
    return sum(sum(a * b for a, b in zip(p, u)) ** 2 for p in c) / len(c)


def pc1_angle(points):
    c = center(points)
    n = len(c)
    sxx = sum(p[0] * p[0] for p in c) / n
    syy = sum(p[1] * p[1] for p in c) / n
    sxy = sum(p[0] * p[1] for p in c) / n
    return 0.5 * math.atan2(2 * sxy, sxx - syy)

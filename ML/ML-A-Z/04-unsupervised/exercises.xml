</answerpreload><globalextra /><useace /><resultcolumns /><template /><iscombinatortemplate /><allowmultiplestdins /><answer>def _d2(a, b):
    return sum((x - y) ** 2 for x, y in zip(a, b))


def assign(points, centroids):
    labels = []
    for p in points:
        best, bd = 0, None
        for j, c in enumerate(centroids):
            d = _d2(p, c)
            if bd is None or d &lt; bd:
                bd, best = d, j
        labels.append(best)
    return labels


def update(points, labels, k):
    dim = len(points[0])
    sums = [[0.0] * dim for _ in range(k)]
    counts = [0] * k
    for p, l in zip(points, labels):
        counts[l] += 1
        for j in range(dim):
            sums[l][j] += p[j]
    out = []
    for j in range(k):
        if counts[j] == 0:
            out.append([0.0] * dim)
        else:
            out.append([s / counts[j] for s in sums[j]])
    return out


def lloyd(points, centroids, n_iter):
    cs = [list(c) for c in centroids]
    for _ in range(n_iter):
        labels = assign(points, cs)
        cs = update(points, labels, len(cs))
    return cs

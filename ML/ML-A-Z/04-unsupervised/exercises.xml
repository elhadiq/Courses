</answerpreload><globalextra /><useace /><resultcolumns /><template /><iscombinatortemplate /><allowmultiplestdins /><answer>import math


def _dist(a, b):
    return math.sqrt(sum((x - y) ** 2 for x, y in zip(a, b)))


def silhouette(points, labels):
    clusters = sorted(set(labels))
    if len(clusters) &lt; 2:
        return 0.0
    total = 0.0
    for i, p in enumerate(points):
        own = [j for j, l in enumerate(labels) if l == labels[i] and j != i]
        if not own:
            continue
        a = sum(_dist(p, points[j]) for j in own) / len(own)
        b = None
        for c in clusters:
            if c == labels[i]:
                continue
            other = [j for j, l in enumerate(labels) if l == c]
            if not other:
                continue
            m = sum(_dist(p, points[j]) for j in other) / len(other)
            if b is None or m &lt; b:
                b = m
        if b is None or max(a, b) == 0:
            continue
        total += (b - a) / max(a, b)
    return total / len(points)

</answerpreload><globalextra /><useace /><resultcolumns /><template /><iscombinatortemplate /><allowmultiplestdins /><answer>import math

EPS = 1e-12


def cross_entropy(ys, ps):
    total = 0.0
    for y, p in zip(ys, ps):
        p = min(max(p, EPS), 1.0 - EPS)
        total += -(y * math.log(p) + (1 - y) * math.log(1 - p))
    return total / len(ys)

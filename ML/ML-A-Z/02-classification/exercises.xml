</answerpreload><globalextra /><useace /><resultcolumns /><template /><iscombinatortemplate /><allowmultiplestdins /><answer>def hinge_loss(ys, scores):
    return sum(max(0.0, 1.0 - y * s) for y, s in zip(ys, scores)) / len(ys)


def n_support(ys, scores):
    return sum(1 for y, s in zip(ys, scores) if y * s &lt;= 1)

def sigmoid(z):
    if z &gt;= 0:
        return 1.0 / (1.0 + math.exp(-z))
    ez = math.exp(z)
    return ez / (1.0 + ez)


def predict_proba(x, theta):
    return sigmoid(sum(a * b for a, b in zip(x, theta)))

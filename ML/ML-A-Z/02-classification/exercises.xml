</answerpreload><globalextra /><useace /><resultcolumns /><template /><iscombinatortemplate /><allowmultiplestdins /><answer>import math


def knn_predict(train_X, train_y, x, k):
    pairs = []
    for xi, yi in zip(train_X, train_y):
        d = math.sqrt(sum((a - b) ** 2 for a, b in zip(xi, x)))
        pairs.append((d, yi))
    pairs.sort(key=lambda t: t[0])
    counts = {}
    for _, lab in pairs[:k]:
        counts[lab] = counts.get(lab, 0) + 1
    best = max(counts.values())
    return min(lab for lab, c in counts.items() if c == best)

</answerpreload><globalextra /><useace /><resultcolumns /><template /><iscombinatortemplate /><allowmultiplestdins /><answer>def laplacian(n, edges):
    L = [[0] * n for _ in range(n)]
    for u, v in edges:
        L[u][v] -= 1
        L[v][u] -= 1
        L[u][u] += 1
        L[v][v] += 1
    return L


def quad_form(n, edges, f):
    return float(sum((f[u] - f[v]) ** 2 for u, v in edges))


def quad_form_matrix(L, f):
    n = len(L)
    return float(sum(f[i] * L[i][j] * f[j] for i in range(n) for j in range(n)))

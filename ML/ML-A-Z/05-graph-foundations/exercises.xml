</answerpreload><globalextra /><useace /><resultcolumns /><template /><iscombinatortemplate /><allowmultiplestdins /><answer>def components(n, edges):
    adj = [[] for _ in range(n)]
    for u, v in edges:
        adj[u].append(v)
        adj[v].append(u)
    comp = [-1] * n
    cid = 0
    for s in range(n):
        if comp[s] != -1:
            continue
        queue = [s]
        comp[s] = cid
        while queue:
            u = queue.pop(0)
            for w in adj[u]:
                if comp[w] == -1:
                    comp[w] = cid
                    queue.append(w)
        cid += 1
    return comp


def n_components(n, edges):
    return max(components(n, edges)) + 1 if n &gt; 0 else 0

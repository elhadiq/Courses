</answerpreload><globalextra /><useace /><resultcolumns /><template /><iscombinatortemplate /><allowmultiplestdins /><answer>def homophily(edges, labels):
    if not edges:
        return 0.0
    same = sum(1 for u, v in edges if labels[u] == labels[v])
    return same / len(edges)


def verdict(h):
    if h &gt; 0.6:
        return 'homophilous'
    if h &lt; 0.4:
        return 'heterophilous'
    return 'mixed'

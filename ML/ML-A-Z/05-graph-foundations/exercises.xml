</answerpreload><globalextra /><useace /><resultcolumns /><template /><iscombinatortemplate /><allowmultiplestdins /><answer>def matmul(A, B):
    n = len(A)
    m = len(B[0])
    p = len(B)
    C = [[0] * m for _ in range(n)]
    for i in range(n):
        for k in range(p):
            if A[i][k] == 0:
                continue
            aik = A[i][k]
            for j in range(m):
                C[i][j] += aik * B[k][j]
    return C


def matpow(A, k):
    R = [row[:] for row in A]
    for _ in range(k - 1):
        R = matmul(R, A)
    return R


def count_triangles(A):
    A3 = matpow(A, 3)
    trace = sum(A3[i][i] for i in range(len(A)))
    return trace // 6

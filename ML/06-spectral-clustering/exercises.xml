</answerpreload><globalextra /><useace /><resultcolumns /><template /><iscombinatortemplate /><allowmultiplestdins /><answer>def _degrees(n, edges):
    d = [0] * n
    for u, v in edges:
        d[u] += 1
        d[v] += 1
    return d


def conductance(n, edges, A):
    d = _degrees(n, edges)
    vol_a = sum(d[u] for u in A)
    vol_b = sum(d) - vol_a
    denom = min(vol_a, vol_b)
    if denom == 0:
        return float('inf')
    c = sum(1 for u, v in edges if (u in A) != (v in A))
    return c / denom


def sweep_cut(n, edges, fiedler):
    order = sorted(range(n), key=lambda i: fiedler[i])
    best_k, best_phi = None, float('inf')
    A = set()
    for k in range(n - 1):
        A.add(order[k])
        phi = conductance(n, edges, A)
        if phi &lt; best_phi:
            best_phi, best_k = phi, k + 1
    return (best_k, best_phi)

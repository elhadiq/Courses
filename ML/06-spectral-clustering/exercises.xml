</answerpreload><globalextra /><useace /><resultcolumns /><template /><iscombinatortemplate /><allowmultiplestdins /><answer>def choose_k(eigenvalues, max_k):
    best_k, best_gap = 1, -1.0
    limit = min(max_k, len(eigenvalues) - 1)
    for k in range(1, limit + 1):
        gap = eigenvalues[k] - eigenvalues[k - 1]
        if gap &gt; best_gap + 1e-12:
            best_gap, best_k = gap, k
    return best_k

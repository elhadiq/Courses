</answerpreload><globalextra /><useace /><resultcolumns /><template /><iscombinatortemplate /><allowmultiplestdins /><answer>def cut(edges, A):
    return sum(1 for u, v in edges if (u in A) != (v in A))


def _degrees(n, edges):
    d = [0] * n
    for u, v in edges:
        d[u] += 1
        d[v] += 1
    return d


def ratio_cut(n, edges, A):
    a = len(A)
    b = n - a
    if a == 0 or b == 0:
        return float('inf')
    c = cut(edges, A)
    return c / a + c / b


def ncut(n, edges, A):
    a = len(A)
    if a == 0 or a == n:
        return float('inf')
    d = _degrees(n, edges)
    vol_a = sum(d[u] for u in A)
    vol_b = sum(d) - vol_a
    if vol_a == 0 or vol_b == 0:
        return float('inf')
    c = cut(edges, A)
    return c / vol_a + c / vol_b

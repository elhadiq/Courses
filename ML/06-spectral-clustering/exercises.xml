</answerpreload><globalextra /><useace /><resultcolumns /><template /><iscombinatortemplate /><allowmultiplestdins /><answer>import math


def knn_graph(points, k):
    n = len(points)
    edges = set()
    for i in range(n):
        d = []
        for j in range(n):
            if i == j:
                continue
            dist = math.sqrt(sum((a - b) ** 2 for a, b in zip(points[i], points[j])))
            d.append((dist, j))
        d.sort()
        for _, j in d[:k]:
            edges.add((min(i, j), max(i, j)))
    return sorted(edges)

    <answer fraction="0" format="html"><text><![CDATA[It only runs Solidity]]></text><feedback format="html"><text>No.</text></feedback></answer>
  </question>

  <question type="truefalse">
    <name><text>S14 C6 — Storage cost</text></name>
    <questiontext format="html"><text><![CDATA[<p>Because storage is persistent, writing to it is among the most expensive operations in the EVM.</p>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>True. Persisting data across all future blocks is costly, which is why writing to storage carries a high gas price.</p>]]></text></generalfeedback>

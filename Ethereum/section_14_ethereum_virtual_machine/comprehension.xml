    <answer fraction="100" format="html"><text><![CDATA[Computation is bounded by the gas limit]]></text><feedback format="html"><text>Correct.</text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[It cannot do arithmetic]]></text><feedback format="html"><text>No.</text></feedback></answer>

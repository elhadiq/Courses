    <questiontext format="html"><text><![CDATA[<p>How much gas is the base cost of sending a transaction?</p>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>21,000 gas, before any opcode costs are added.</p>]]></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <answer fraction="100" format="moodle_auto_format"><text>21000</text><feedback format="html"><text>Correct.</text></feedback><tolerance>0</tolerance></answer>
  </question>

  <question type="truefalse">
    <name><text>S14 C4 — Out of gas</text></name>
    <questiontext format="html"><text><![CDATA[<p>If a transaction runs out of gas, its state changes are rolled back but the gas already consumed is still charged.</p>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>True. Validators did the work up to that point, so they are still compensated even though the transaction reverts.</p>]]></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>1.0000000</penalty>
    <hidden>0</hidden>
    <answer fraction="100" format="moodle_auto_format"><text>true</text><feedback format="html"><text>Correct.</text></feedback></answer>
    <answer fraction="0" format="moodle_auto_format"><text>false</text><feedback format="html"><text>Incorrect.</text></feedback></answer>
  </question>


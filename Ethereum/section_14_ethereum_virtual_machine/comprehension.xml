  <question type="multichoice">
    <name><text>S14 C1 — Stack order</text></name>
    <questiontext format="html"><text><![CDATA[<p>What order does the EVM stack follow?</p>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>Last-in, first-out (LIFO): the most recently pushed item is the first one popped.</p>]]></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <correctfeedback format="html"><text>Correct.</text></correctfeedback>
    <partiallycorrectfeedback format="html"><text>Partially correct.</text></partiallycorrectfeedback>
    <incorrectfeedback format="html"><text>Review section 1 of the lesson.</text></incorrectfeedback>
    <answer fraction="100" format="html"><text><![CDATA[Last-in, first-out (LIFO)]]></text><feedback format="html"><text>Correct.</text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[First-in, first-out (FIFO)]]></text><feedback format="html"><text>No.</text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[Random access]]></text><feedback format="html"><text>No.</text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[Sorted order]]></text><feedback format="html"><text>No.</text></feedback></answer>
  </question>

  <question type="multichoice">
    <name><text>S14 C2 — Persistent area</text></name>
    <questiontext format="html"><text><![CDATA[<p>Which EVM data area keeps its contents between transactions?</p>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>Storage is the persistent, per-contract key-value store; stack, memory and calldata do not survive.</p>]]></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <correctfeedback format="html"><text>Correct.</text></correctfeedback>
    <partiallycorrectfeedback format="html"><text>Partially correct.</text></partiallycorrectfeedback>
    <incorrectfeedback format="html"><text>Review section 2 of the lesson.</text></incorrectfeedback>
    <answer fraction="100" format="html"><text><![CDATA[Storage]]></text><feedback format="html"><text>Correct.</text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[Memory]]></text><feedback format="html"><text>Memory is volatile.</text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[The stack]]></text><feedback format="html"><text>The stack is temporary.</text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[Calldata]]></text><feedback format="html"><text>Calldata is read-only input.</text></feedback></answer>
  </question>

  <question type="numerical">

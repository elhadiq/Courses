  <question type="numerical">
    <name><text>S1 C5 — Gas left</text></name>
    <questiontext format="html"><text><![CDATA[<p>A transaction has a gas limit of 100. Its instructions cost 10, 20 and 30 gas and all run successfully. How many units of gas are left?</p>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>100 &minus; (10 + 20 + 30) = 40.</p>]]></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <answer fraction="100" format="moodle_auto_format"><text>40</text><feedback format="html"><text>Correct.</text></feedback><tolerance>0</tolerance></answer>
  </question>


    <allowmultiplestdins></allowmultiplestdins>
    <answer><![CDATA[def faucet_withdraw(balance, request, limit):
    if request > limit:
        return "Withdrawal too big"
    if request > balance:
        return "Insufficient funds"
    return balance - request
]]></answer>

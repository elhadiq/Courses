  <question type="multichoice">
    <name><text>S7 C3 — Multisig loss</text></name>
    <questiontext format="html"><text><![CDATA[<p>In a 2-of-3 multisig, how many keys can you lose and still spend?</p>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>You need any 2 of the 3, so losing 1 is fine.</p>]]></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <correctfeedback format="html"><text>Correct.</text></correctfeedback>
    <partiallycorrectfeedback format="html"><text>Partially correct.</text></partiallycorrectfeedback>
    <incorrectfeedback format="html"><text>Not quite — review the lesson.</text></incorrectfeedback>
    <answer fraction="100" format="html"><text><![CDATA[One]]></text><feedback format="html"><text>Correct.</text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[Zero]]></text><feedback format="html"><text>You may lose one.</text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[Two]]></text><feedback format="html"><text>You need 2 to sign.</text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[Three]]></text><feedback format="html"><text>No.</text></feedback></answer>
  </question>

  <question type="multichoice">
    <name><text>S7 C4 — OP_RETURN opcode</text></name>
    <questiontext format="html"><text><![CDATA[<p>Which opcode marks an OP_RETURN data output?</p>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>OP_RETURN is byte 0x6a.</p>]]></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <correctfeedback format="html"><text>Correct.</text></correctfeedback>
    <partiallycorrectfeedback format="html"><text>Partially correct.</text></partiallycorrectfeedback>
    <incorrectfeedback format="html"><text>Not quite — review the lesson.</text></incorrectfeedback>
    <answer fraction="100" format="html"><text><![CDATA[0x6a]]></text><feedback format="html"><text>Correct.</text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[0x00]]></text><feedback format="html"><text>No.</text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[0xff]]></text><feedback format="html"><text>No.</text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[0x51]]></text><feedback format="html"><text>That is OP_1.</text></feedback></answer>
  </question>


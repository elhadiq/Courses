  <question type="numerical">
    <name><text>S7 C1 — Stack result</text></name>
    <questiontext format="html"><text><![CDATA[<p>After running the script 7 OP_DUP OP_ADD, what value is on top of the stack?</p>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>7 is duplicated, then OP_ADD gives 7+7=14.</p>]]></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <answer fraction="100" format="moodle_auto_format"><text>14</text><feedback format="html"><text>Correct.</text></feedback><tolerance>0</tolerance></answer>
  </question>


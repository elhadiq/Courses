  <question type="numerical">
    <name><text>S5 C3 — Word count</text></name>
    <questiontext format="html"><text><![CDATA[<p>How many words does a BIP39 phrase built from 128 bits of entropy have?</p>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>words = (128 + 128/32)/11 = 132/11 = 12.</p>]]></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <answer fraction="100" format="moodle_auto_format"><text>12</text><feedback format="html"><text>Correct.</text></feedback><tolerance>0</tolerance></answer>
  </question>

  <question type="multichoice">
    <name><text>S5 C4 — Hardened offset</text></name>
    <questiontext format="html"><text><![CDATA[<p>A hardened derivation level adds which value to its index?</p>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>Hardened child numbers are >= 2^31.</p>]]></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <correctfeedback format="html"><text>Correct.</text></correctfeedback>
    <partiallycorrectfeedback format="html"><text>Partially correct.</text></partiallycorrectfeedback>
    <incorrectfeedback format="html"><text>Not quite — review the lesson.</text></incorrectfeedback>
    <answer fraction="100" format="html"><text><![CDATA[2**31 (2,147,483,648)]]></text><feedback format="html"><text>Correct.</text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[2**32]]></text><feedback format="html"><text>No.</text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[1000]]></text><feedback format="html"><text>No.</text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[100,000]]></text><feedback format="html"><text>No.</text></feedback></answer>
  </question>

  <question type="numerical">
    <name><text>S5 C5 — Hardened child number</text></name>
    <questiontext format="html"><text><![CDATA[<p>In the path m/44'/0'/0'/0/0, what is the child number of the level written 44' ?</p>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>44 + 2^31 = 44 + 2147483648 = 2147483692.</p>]]></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <answer fraction="100" format="moodle_auto_format"><text>2147483692</text><feedback format="html"><text>Correct.</text></feedback><tolerance>0</tolerance></answer>
  </question>


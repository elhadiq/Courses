  <question type="multichoice">
    <name><text>S5 C1 — What a wallet stores</text></name>
    <questiontext format="html"><text><![CDATA[<p>What does a Bitcoin wallet actually store?</p>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>Coins are on the ledger; the wallet holds the keys.</p>]]></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <correctfeedback format="html"><text>Correct.</text></correctfeedback>
    <partiallycorrectfeedback format="html"><text>Partially correct.</text></partiallycorrectfeedback>
    <incorrectfeedback format="html"><text>Not quite — review the lesson.</text></incorrectfeedback>
    <answer fraction="100" format="html"><text><![CDATA[The private keys that control your coins]]></text><feedback format="html"><text>Correct.</text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[The coins themselves]]></text><feedback format="html"><text>Coins live on the ledger.</text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[A copy of the whole blockchain]]></text><feedback format="html"><text>That is a full node.</text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[Your bank account details]]></text><feedback format="html"><text>No.</text></feedback></answer>
  </question>

  <question type="truefalse">
    <name><text>S5 C2 — Entropy and words</text></name>
    <questiontext format="html"><text><![CDATA[<p>256 bits of entropy produce a 24-word BIP39 recovery phrase.</p>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>Correct.</p>]]></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>1.0000000</penalty>
    <hidden>0</hidden>

<?xml version="1.0" encoding="UTF-8"?>
<quiz>

  <question type="category">
    <category><text>$course$/Mastering Bitcoin/Section 2 - How Bitcoin Works (Comprehension)</text></category>
  </question>

  <question type="multichoice">
    <name><text>S2 C1 — What is a UTXO?</text></name>
    <questiontext format="html"><text><![CDATA[<p>Which statement best describes a <strong>UTXO</strong>?</p>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>A UTXO is an unspent transaction output — a discrete chunk of bitcoin you can still spend, like a bill in your pocket.</p>]]></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <correctfeedback format="html"><text>Correct.</text></correctfeedback>
    <partiallycorrectfeedback format="html"><text>Partially correct.</text></partiallycorrectfeedback>
    <incorrectfeedback format="html"><text>Review "coins are UTXOs".</text></incorrectfeedback>
    <answer fraction="100" format="html"><text><![CDATA[An unspent chunk of bitcoin that a wallet can spend]]></text><feedback format="html"><text>Correct.</text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[A running account balance stored by your bank]]></text><feedback format="html"><text>Bitcoin has no account balances.</text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[The fee paid to a miner]]></text><feedback format="html"><text>That is the fee, not a UTXO.</text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[A private key]]></text><feedback format="html"><text>A key unlocks a UTXO; it is not one.</text></feedback></answer>
  </question>

  <question type="truefalse">
    <name><text>S2 C2 — Balances vs. outputs</text></name>
    <questiontext format="html"><text><![CDATA[<p>Bitcoin tracks a single account balance for each user, the way a bank does.</p>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>False — Bitcoin has no balances. Your balance is simply the sum of the UTXOs you control.</p>]]></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>1.0000000</penalty>
    <hidden>0</hidden>
    <answer fraction="0" format="moodle_auto_format"><text>true</text><feedback format="html"><text>Bitcoin uses UTXOs, not balances.</text></feedback></answer>
    <answer fraction="100" format="moodle_auto_format"><text>false</text><feedback format="html"><text>Correct.</text></feedback></answer>
  </question>

  <question type="truefalse">
    <name><text>S2 C3 — Spending an input</text></name>
    <questiontext format="html"><text><![CDATA[<p>An input must be spent in full, which is why wallets create a change output.</p>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>Correct: you cannot spend part of a UTXO, so the leftover is returned to you as change.</p>]]></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>1.0000000</penalty>
    <hidden>0</hidden>
    <answer fraction="100" format="moodle_auto_format"><text>true</text><feedback format="html"><text>Correct.</text></feedback></answer>
    <answer fraction="0" format="moodle_auto_format"><text>false</text><feedback format="html"><text>Inputs are spent in full; the remainder becomes change.</text></feedback></answer>
  </question>

  <question type="multichoice">
    <name><text>S2 C4 — How the fee is defined</text></name>
    <questiontext format="html"><text><![CDATA[<p>How is a transaction's fee determined?</p>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>The fee is not stated directly; it is whatever is left over: sum of inputs minus sum of outputs.</p>]]></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <correctfeedback format="html"><text>Correct.</text></correctfeedback>
    <partiallycorrectfeedback format="html"><text>Partially correct.</text></partiallycorrectfeedback>
    <incorrectfeedback format="html"><text>Review "the fee = inputs minus outputs".</text></incorrectfeedback>
    <answer fraction="100" format="html"><text><![CDATA[Sum of inputs minus sum of outputs]]></text><feedback format="html"><text>Correct.</text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[A fixed amount set by the Bitcoin protocol]]></text><feedback format="html"><text>Fees are not fixed by the protocol.</text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[A percentage of the amount, chosen by the recipient]]></text><feedback format="html"><text>The recipient does not set the fee.</text></feedback></answer>
  </question>

  <question type="numerical">
    <name><text>S2 C5 — Compute the fee</text></name>
    <questiontext format="html"><text><![CDATA[<p>A transaction spends inputs of 200,000 and 50,000 sat, and creates outputs of 220,000 and 20,000 sat. What is the fee (in satoshis)?</p>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>(200,000 + 50,000) &minus; (220,000 + 20,000) = 250,000 &minus; 240,000 = 10,000 sat.</p>]]></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <answer fraction="100" format="moodle_auto_format"><text>10000</text><feedback format="html"><text>Correct.</text></feedback><tolerance>0</tolerance></answer>
  </question>

  <question type="numerical">
    <name><text>S2 C6 — Compute the change</text></name>
    <questiontext format="html"><text><![CDATA[<p>You spend a single 500,000 sat UTXO to pay 300,000 sat with a 2,000 sat fee. What change (in satoshis) does your wallet return to you?</p>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>change = 500,000 &minus; 300,000 &minus; 2,000 = 198,000 sat.</p>]]></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <answer fraction="100" format="moodle_auto_format"><text>198000</text><feedback format="html"><text>Correct.</text></feedback><tolerance>0</tolerance></answer>
  </question>

  <question type="multichoice">
    <name><text>S2 C7 — The no-inflation rule</text></name>
    <questiontext format="html"><text><![CDATA[<p>For a normal (non-coinbase) transaction to be valid, which condition must hold?</p>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>Outputs must not exceed inputs (no money from nothing), and every output must be positive.</p>]]></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <correctfeedback format="html"><text>Correct.</text></correctfeedback>
    <partiallycorrectfeedback format="html"><text>Partially correct.</text></partiallycorrectfeedback>
    <incorrectfeedback format="html"><text>Review "no money from nothing".</text></incorrectfeedback>
    <answer fraction="100" format="html"><text><![CDATA[Sum of outputs is less than or equal to sum of inputs]]></text><feedback format="html"><text>Correct.</text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[Sum of outputs is greater than sum of inputs]]></text><feedback format="html"><text>That would create money from nothing.</text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[Inputs and outputs must be exactly equal (no fee allowed)]]></text><feedback format="html"><text>A fee is the difference; they need not be equal.</text></feedback></answer>
  </question>

</quiz>

  <question type="multichoice">
    <name><text>S11 C2 — Odd level</text></name>
    <questiontext format="html"><text><![CDATA[<p>In a merkle tree, what happens to the last hash on a level with an odd number of hashes?</p>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>Duplication makes the count even.</p>]]></text></generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <correctfeedback format="html"><text>Correct.</text></correctfeedback>
    <partiallycorrectfeedback format="html"><text>Partially correct.</text></partiallycorrectfeedback>
    <incorrectfeedback format="html"><text>Not quite — review the lesson.</text></incorrectfeedback>
    <answer fraction="100" format="html"><text><![CDATA[It is duplicated so it can be paired]]></text><feedback format="html"><text>Correct.</text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[It is discarded]]></text><feedback format="html"><text>No, it is duplicated.</text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[It becomes the root]]></text><feedback format="html"><text>No.</text></feedback></answer>
